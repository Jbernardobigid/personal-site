# Copy to .env and fill in. NEVER commit .env — it is gitignored, and this repo
# is public. Names and purposes only; no values belong in this file.
#
# GitHub Actions reads the same names from repo secrets; the VPS reads them from
# its own /home/ubuntu/personal-site/.env. Adding a variable here does not add it
# there — update all three when a new secret is introduced.

# ── Site ──────────────────────────────────────────────────
# Canonical origin used to build post URLs, the sitemap, the RSS feed, the
# podcast feed's self-link and the Instagram media URLs. Must be the
# NON-redirecting host: the apex 307s to www, so this stays on www. Changing it
# rewrites podcast.xml's <atom:link rel="self">, which is the feed's identity
# for Spotify/Apple — do not change it casually.
SITE_URL=

# ── Model providers ───────────────────────────────────────
ANTHROPIC_API_KEY=          # blog + carousel + video copy (Claude)
OPENAI_API_KEY=             # OG images, Whisper caption timing, gpt-image-2 stills
GEMINI_API_KEY=             # optional, experimental
KIMIK3_API_KEY=             # optional, experimental
TAVILY_API_KEY=             # research grounding for blog + newsletter signals

# ── Voice / video ─────────────────────────────────────────
ELEVENLABS_API_KEY=         # voice clone for Reels + podcast narration
ELEVENLABS_VOICE_ID=        # the cloned voice to render with
kIE_API_KEY=                # optional; only for --kie-broll (note the lowercase k)
KIE_BROLL_MODEL=            # optional b-roll model override
KIE_BROLL_RES=              # optional b-roll resolution override
AUDIO_TTS_MODEL=            # optional podcast TTS model override
AUDIO_MAX_CHARS=            # optional cap on narration length

# ── Instagram (Graph API) ─────────────────────────────────
INSTAGRAM_ACCESS_TOKEN=     # long-lived token; refreshed by refresh-ig-token.mjs
INSTAGRAM_APP_SECRET=
INSTAGRAM_USER_ID=
INSTAGRAM_API_BASE=         # optional Graph API base override
COMMENT_TRIGGER_KEYWORD=    # optional; reply-to-comments.mjs trigger word
COMMENT_REPLY_MESSAGE=      # optional; the auto-reply body

# ── LinkedIn ──────────────────────────────────────────────
LINKEDIN_ACCESS_TOKEN=      # OAuth 2.0 member token

# ── Notion (approval queues) ──────────────────────────────
NOTION_API_KEY=
NOTION_IG_DB_ID=            # Instagram/Reel approval database
NOTION_METRICS_DB_ID=       # performance metrics database
NOTION_NEWSLETTER_DB_ID=    # newsletter approval database

# ── Email (Resend) ────────────────────────────────────────
RESEND_API_KEY=             # also used by api/subscribe.js on Vercel
RESEND_AUDIENCE_ID=         # also used by api/subscribe.js on Vercel
NEWSLETTER_FROM=            # optional From header override
NEWSLETTER_URL=             # optional subscribe link override
PUBLIC_SITE_URL=            # optional brand origin for newsletter canonical links
CAROUSEL_NOTIFY_EMAIL=      # optional; where build notifications go

# ── Storage ───────────────────────────────────────────────
BLOB_READ_WRITE_TOKEN=      # Vercel Blob (Reel video + podcast audio hosting)

# ── Strava (cycling topic generation) ─────────────────────
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=

# ── n8n (VPS orchestration) ───────────────────────────────
N8N_VPS_URL=
N8N_VPS_API_KEY=

# ── Local tooling ─────────────────────────────────────────
CHROME_PATH=                # Chrome/Chromium for Puppeteer; scripts fall back to
                            # the default puppeteer cache path when unset
JORGE_CAROUSEL_PHOTO=       # optional; force a specific photo in a carousel
REEL_PHOTO_FILTER=          # optional; restrict the Reel b-roll photo pool
SIM_AGENT_MODEL=            # optional; audience-simulation model override
